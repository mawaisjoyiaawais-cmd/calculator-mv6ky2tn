#:kivy 2.3.0

<CalculatorLayout>:
    orientation: 'vertical'
    padding: 10
    spacing: 10

    Label:
        id: display
        text: "0"
        font_size: '64sp'
        size_hint: 1, 0.25
        halign: 'right'
        valign: 'middle'
        # text_size allows text to wrap, but for a calculator we want it on one line.
        # This, combined with halign, keeps it aligned to the right.
        text_size: self.width - 20, self.height

    # Define a base style for all calculator buttons to reduce repetition
    <CalcButton@Button>:
        font_size: '32sp'
        background_color: (0.3, 0.3, 0.3, 1) # Dark grey for number buttons
        background_normal: '' # This is needed to make background_color work

    # A different style for operator buttons
    <OperatorButton@CalcButton>:
        background_color: (0.9, 0.5, 0, 1) # Orange color for operators

    GridLayout:
        cols: 4
        spacing: 10
        size_hint: 1, 0.75

        # --- Row 1 ---
        OperatorButton:
            text: "C"
            on_press: root.clear_all()
        OperatorButton:
            text: "CE"
            on_press: root.backspace()
        OperatorButton:
            text: "/"
            on_press: root.button_pressed(self)
        OperatorButton:
            text: "*"
            on_press: root.button_pressed(self)

        # --- Row 2 ---
        CalcButton:
            text: "7"
            on_press: root.button_pressed(self)
        CalcButton:
            text: "8"
            on_press: root.button_pressed(self)
        CalcButton:
            text: "9"
            on_press: root.button_pressed(self)
        OperatorButton:
            text: "-"
            on_press: root.button_pressed(self)

        # --- Row 3 ---
        CalcButton:
            text: "4"
            on_press: root.button_pressed(self)
        CalcButton:
            text: "5"
            on_press: root.button_pressed(self)
        CalcButton:
            text: "6"
            on_press: root.button_pressed(self)
        OperatorButton:
            text: "+"
            on_press: root.button_pressed(self)

        # --- Row 4 ---
        CalcButton:
            text: "1"
            on_press: root.button_pressed(self)
        CalcButton:
            text: "2"
            on_press: root.button_pressed(self)
        CalcButton:
            text: "3"
            on_press: root.button_pressed(self)
        OperatorButton:
            id: equals_button
            text: "="
            rowspan: 2 # Make the equals button span two rows
            on_press: root.calculate()
            background_color: (0.2, 0.6, 0.2, 1) # Green color for equals

        # --- Row 5 ---
        CalcButton:
            text: "0"
            colspan: 2 # Make the '0' button span two columns
            on_press: root.button_pressed(self)
        CalcButton:
            text: "."
            on_press: root.button_pressed(self)
        # The space for the equals button is automatically handled by its rowspan from the row above.
